  "scripts": {
    "dev": "vite",
    "dev:clean": "rm -rf node_modules/.vite && vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm run test && npm run test:backend",
    "export:demo": "bun -e \"import { writeFileSync, mkdirSync } from 'fs'; import { serializeScribeDemoContent } from './src/lib/templates/demo-guide.ts'; mkdirSync('src-tauri/assets', { recursive: true }); writeFileSync('src-tauri/assets/scribe-demo-content.json', serializeScribeDemoContent())\"",
    "preview": "vite preview",
    "postinstall": "node scripts/dedupe-prosemirror-model.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:clean": "rm -rf node_modules/.vite && tauri dev",
    "tauri:build": "tauri build"
  },
