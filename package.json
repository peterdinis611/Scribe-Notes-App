{
  "name": "scribe",
  "private": true,
  "version": "1.4.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:debug": "VITE_DEBUG=1 vite",
    "dev:clean": "rm -rf node_modules/.vite && vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "cargo test --workspace",
    "test:all": "npm run test && npm run test:backend && npm run nlp:test",
    "preview": "vite preview",
    "postinstall": "node --experimental-strip-types scripts/ensure-prosemirror-singleton.ts",
    "pm:check": "node --experimental-strip-types scripts/ensure-prosemirror-singleton.ts --check",
    "tauri": "tauri",
    "tauri:dev": "node --experimental-strip-types scripts/tauri-dev-with-mcp.ts",
    "tauri:dev:debug": "SCRIBE_DEBUG=1 node --experimental-strip-types scripts/tauri-dev-with-mcp.ts --debug",
    "tauri:dev:clean": "rm -rf node_modules/.vite && npm run tauri:dev",
    "tauri:dev:app": "tauri dev",
    "tauri:dev:app:debug": "SCRIBE_DEBUG=1 SCRIBE_NLP_DEBUG=1 SCRIBE_RUST_LOG=debug RUST_LOG=debug VITE_DEBUG=1 TAURI_DEBUG=1 tauri dev",
    "tauri:build": "tauri build",
    "mcp": "cargo run --release -p scribe-mcp",
    "mcp:debug": "RUST_LOG=debug cargo run -p scribe-mcp",
    "mcp:build": "cargo build --release -p scribe-mcp",
    "mcp:install": "cargo build --release -p scribe-mcp",
    "nlp:health": "printf '%s\\n' '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"health\",\"params\":{}}' | python3 nlp/scribe_nlp/__main__.py",
    "nlp:debug": "SCRIBE_NLP_DEBUG=1 PYTHONPATH=nlp python3 -m scribe_nlp.debug_cli",
    "nlp:test": "PYTHONPATH=nlp python3 -m unittest discover -s nlp/tests -p 'test_*.py'"
  },
