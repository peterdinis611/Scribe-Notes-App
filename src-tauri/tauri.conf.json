{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Scribe",
  "version": "4.2.0",
  "identifier": "com.scribe.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Scribe 2.7",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:* http://localhost:5174 ws://localhost:5174 http://localhost:8787; media-src 'self' asset: http://asset.localhost blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'self' asset: http://asset.localhost blob:; report-uri ipc://localhost/csp-report",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$TEMP/**",
          "$CACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "scribe"
        ],
        "name": "Scribe Document",
        "description": "Scribe document",
        "role": "Editor",
        "mimeType": "application/x-scribe+json",
        "exportedType": {
          "identifier": "com.scribe.app.document",
          "conformsTo": [
            "public.json",
            "public.data"
          ]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "files": {
        "Resources/scribe-document.icns": "icons/scribe-document.icns"
      }
    },
    "resources": {
      "../nlp/scribe_nlp/": "nlp/scribe_nlp/",
      "../nlp/pyproject.toml": "nlp/pyproject.toml"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
