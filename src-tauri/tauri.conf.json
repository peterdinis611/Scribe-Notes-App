{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Scribe",
  "version": "2.4.0",
  "identifier": "com.scribe.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Scribe 2.3",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOCUMENT/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["scribe"],
        "name": "Scribe Document",
        "description": "Scribe document",
        "role": "Editor",
        "mimeType": "application/x-scribe+json",
        "exportedType": {
          "identifier": "com.scribe.app.document",
          "conformsTo": ["public.json", "public.data"]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "files": {
        "Resources/scribe-document.icns": "icons/scribe-document.icns"
      }
    },
    "resources": {
      "../nlp/scribe_nlp/": "nlp/scribe_nlp/",
      "../nlp/pyproject.toml": "nlp/pyproject.toml"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
